# =============================================================================
# wiki_kb_service — 公司信息知识库（LLM Wiki + DynamicLLMPathExtractor 图谱）
# 复制为 .env 后按需修改
# =============================================================================

# ── LLM 三选一 ─────────────────────────────
# local_deepseek  = 本地 DeepSeek（Ollama / LM Studio / vLLM 等任意 OpenAI 兼容端点）
# local_ministral = 本地 Ministral（同上）
# online_deepseek = 线上 DeepSeek API
KB_LLM_PROVIDER=local_deepseek

# 本地 DeepSeek（默认假设走 Ollama 的 OpenAI 兼容端点）
KB_LOCAL_DEEPSEEK_BASE_URL=http://localhost:11434/v1
KB_LOCAL_DEEPSEEK_MODEL=deepseek-r1:14b
KB_LOCAL_DEEPSEEK_API_KEY=ollama

# 本地 Ministral
KB_LOCAL_MINISTRAL_BASE_URL=http://localhost:11434/v1
KB_LOCAL_MINISTRAL_MODEL=ministral-8b
KB_LOCAL_MINISTRAL_API_KEY=ollama

# 线上 DeepSeek
KB_ONLINE_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
KB_ONLINE_DEEPSEEK_MODEL=deepseek-chat
KB_ONLINE_DEEPSEEK_API_KEY=              # 必填才能用线上模式

# ── 抽取运行时间限制 ───────────────────────
# 改这一组 = 改「抽取能跑多久」。改完必须重启服务（python run.py --force）才生效，
# 启动日志会打印当前生效值，也可查 GET /api/health 的 limits 字段核对。
# 单 chunk 走 2 次 LLM 调用（关系轮 + 属性轮）：
#   单 chunk 最坏耗时 ≈ KB_LLM_REQUEST_TIMEOUT × (1 + KB_LLM_MAX_RETRIES) × 2
#   默认 600 / 2 → 3600s（1 小时）；本地 14B 部分进显存时建议 1800 / 1 + KB_NUM_WORKERS=1
KB_LLM_REQUEST_TIMEOUT=4000 #66分钟 40秒               # 单次 LLM 请求超时（秒）
KB_LLM_MAX_RETRIES=0                     # 失败重试次数，0=不重试
KB_LLM_CONTEXT_WINDOW=16384              # 上下文窗口（同时用作 max_tokens）

# ── 抽取参数（刻意全开放，不预设 schema）──
KB_MAX_TRIPLETS_PER_CHUNK=90             # 每 chunk 最多三元组数（开放体系：组织/客户/产品细节/技术/里程碑都要抽，25 会严重截断）
KB_CHUNK_SIZE=1200                       # 分块字符数
KB_CHUNK_OVERLAP=150
KB_PROPS_MODE=any                        # any=LLM 自由生成任意属性；none=关闭；或逗号分隔属性名
KB_NUM_WORKERS=4

# ── Wiki 页面 ──
KB_WIKI_SUMMARY_ENABLED=1                # 实体页 LLM 摘要开关
KB_WIKI_SUMMARY_MAX_ENTITIES=10          # 每次 ingest 最多为多少个实体生成 LLM 摘要

# ── 服务 ──
KB_HOST=127.0.0.1
KB_PORT=13105
# KB_DATA_DIR=./data
