# =============================================================================
# Extractor_Agent — 网页抓取 / 结构化抽取 Agent
# 复制为 .env 后按需修改
# 行为默认值见 server/utils/extractor_agent_env.ts
# 能力层模型 SSOT：Manage-platform_Agent/.env.capability-models.example
# =============================================================================

# ── LLM 三选一（OpenAI 兼容协议，改 BASE_URL / MODEL / API_KEY 三个值即可切换）──
# ① 线上 DeepSeek：
#    QWEN_BASE_URL=https://api.deepseek.com
#    QWEN_MODEL=deepseek-chat
#    QWEN_API_KEY=sk-xxxx
# ② 本地 DeepSeek（Ollama / LM Studio / vLLM 等 OpenAI 兼容端点）：
#    QWEN_BASE_URL=http://localhost:11434/v1
#    QWEN_MODEL=deepseek-r1:14b
#    QWEN_API_KEY=ollama
# ③ 本地 Ministral：
#    QWEN_BASE_URL=http://localhost:11434/v1
#    QWEN_MODEL=ministral-8b
#    QWEN_API_KEY=ollama
# 知识库服务（LLM Wiki + 图谱）的模型在其自身目录 wiki_kb_service/.env 中独立配置。
QWEN_API_KEY=                            # 阿里云百炼 API Key（或上面任一提供方的 Key）
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── 能力层模型 ──
QWEN_MODEL=qwen-flash-2025-07-28         # T0 文本抽取 / 规划
QWEN_VL_MODEL=qwen-vl-plus               # T3 视觉抽取（extraction.vision=true 时）
QWEN_ENABLE_THINKING=0                   # qwen3 思考模式需流式，本项目保持 0

# ── 运行模式 ──
# adaptive = 规则+LLM 规划，HTTP 优先，质量不足自动浏览器/云抓取重试（推荐）
# fast     = 规则规划，最省 token
# deep     = 全 LLM + 浏览器，成本高，仅调试
EXTRACTOR_MODE=adaptive

# ── HTTP / WebSocket 服务 ──
CRAWLER_PORT=13104                       # 监听端口
WS_PATH=/_ws                             # WebSocket 路径

# ── 云抓取兜底（京东等高压站点；env 仍用 MCP_* 命名）──
# MCP_PROVIDER=firecrawl                 # firecrawl | zenrows | scraperapi | generic
# MCP_API_KEY=                           # 云抓取 API Key
# MCP_BASE_URL=http://firecrawl:3002/v1/scrape  # 自托管 Firecrawl 地址
# MCP_RENDER=true                        # 是否启用 JS 渲染
# MCP_COUNTRY=US                         # Firecrawl geo 参数
# EXTRACTOR_MCP_MAX_CALLS=6              # 单次任务云抓取最大调用次数（默认 6，与 seed 队列对齐）

# ── 异步队列 / MCP Server ──
# EXTRACTOR_ASYNC_QUEUE=1                # 启用 POST /api/extract/async
# EXTRACTOR_QUEUE_BACKEND=local          # local | redis（多实例用 redis）
# EXTRACTOR_QUEUE_MAX_CONCURRENT=3       # 进程内最大并发 job 数
# REDIS_URL=redis://127.0.0.1:6379/0
# EXTRACTOR_MCP_SERVER=0                 # 1=暴露 JSON-RPC /api/mcp

# ── 爬虫限速 ──
# CRAWLER_MAX_CONCURRENCY=3              # 全局最大并发请求
# EXTRACTOR_DOMAIN_POLITE_DELAY_MS=1200  # 同域最小请求间隔（ms）

# ── 单页 / 整站模式 ──
# 任务里出现「整个网站 / 全站 / 整站 / 所有页面」时自动进入整站模式；
# 出现「主页 / 首页 / 单页」时进入单页模式（整页一条：title/url/excerpt）。
# 也可用请求 options 显式指定：siteCrawl=true / maxDepth=2 / pageMode=single|list|auto
# CRAWLER_SITE_MAX_PAGES=50              # 整站模式最大抓取页数
# CRAWLER_SITE_MAX_ITEMS=50              # 整站模式最大输出条目
# CRAWLER_SITE_MAX_DEPTH=2               # 整站模式链接深度（种子为第 0 层）

# ── 学习栈（默认关）──
# EXTRACTOR_LEARNING=0
# EXTRACTOR_EMBEDDING_MODEL=text-embedding-v3

# ── LLM 启发式（默认开，设 0 关闭）──
# EXTRACTOR_FAILURE_LLM=1
# EXTRACTOR_FEEDBACK_STAGE_LLM=1
# EXTRACTOR_TASK_CONDENSE_LLM=1

# ── 站点补丁 ──
# EXTRACTOR_PATCHES_DIR=./patches        # 站点补丁 JSON 目录

# ── 公司爬取 / 知识库对接 ──
KB_SERVICE_URL=http://127.0.0.1:13105   # wiki_kb_service 地址（LLM Wiki + DynamicLLMPathExtractor 图谱）
KB_AUTO_INGEST=1                        # 公司爬取完成后自动推送知识库 ingest
COMPANY_ATTACH_MAX=20                   # 单次任务下载站内挂载文件上限
